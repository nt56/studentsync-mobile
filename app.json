{
  "expo": {
    "name": "Student Sync",
    "slug": "student-sync",
    "owner": "bhushan_22",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/StudentSync_icon.png",
    "scheme": "studentsync",
    "extra": {
      "eas": {
        "projectId": "ced31dda-8e55-41c3-8121-d8b58b9eed19"
      }
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/StudentSync_icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.studentsync.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a profile photo from your library.",
        "NSCalendarsUsageDescription": "Add events you register for to your calendar.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Add events you register for to your calendar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.studentsync.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2563eb",
        "foregroundImage": "./assets/images/StudentSync_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/StudentSync_icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fafc",
          "image": "./assets/images/StudentSync_icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0b1220"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StudentSync to access your photos so you can set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow StudentSync to add events you register for to your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "owner": "bhushan_22"
  }
}

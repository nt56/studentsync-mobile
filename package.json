    "android:release": "expo run:android --variant release",
    "android:dev-client": "expo start --dev-client --android",
    "ios": "expo run:ios",
    "ios:dev": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "ios:dev-client": "expo start --dev-client --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild:repair": "expo prebuild --clean --npm",
    "build:local": "eas build --platform android --profile development --local",
    "build:local:ios": "eas build --platform ios --profile development --local",
    "build:local:all": "eas build --platform all --profile development --local",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:prod": "eas build --platform ios --profile production",
    "build:all:preview": "eas build --platform all --profile preview",
    "build:all:prod": "eas build --platform all --profile production",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",

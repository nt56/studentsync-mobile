{
  "name": "student-synch-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "babel-preset-expo": "~57.0.13",
    "date-fns": "^4.4.0",
    "expo": "~57.0.26",
    "expo-calendar": "~57.0.5",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.7",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.5",
    "expo-dev-client": "~57.0.19"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3",
    "@react-native/jest-preset": "0.86.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "start:dev-client": "expo start --dev-client",
    "start:dev-client-clear": "expo start --dev-client -c",
    "go": "expo start --go",
    "go:android": "expo start --android --go",
    "go:android-clear": "expo start --android --go -c",
    "go:ios": "expo start --ios --go",
    "android": "expo run:android",
    "android:dev": "expo run:android",
    "android:release": "expo run:android --variant release",
    "android:dev-client": "expo start --dev-client --android",
    "ios": "expo run:ios",
    "ios:dev": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "ios:dev-client": "expo start --dev-client --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild:repair": "expo prebuild --clean --npm",
    "build:local": "npx eas-cli@latest build --platform android --profile development --local",
    "build:local:ios": "npx eas-cli@latest build --platform ios --profile development --local",
    "build:local:all": "npx eas-cli@latest build --platform all --profile development --local",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:prod": "npx eas-cli@latest build --platform android --profile production",
    "build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios:prod": "npx eas-cli@latest build --platform ios --profile production",
    "build:all:preview": "npx eas-cli@latest build --platform all --profile preview",
    "build:all:prod": "npx eas-cli@latest build --platform all --profile production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "npm run typecheck && npm run lint && npm test -- --runInBand",
    "doctor": "npx expo-doctor",
    "check:env": "node scripts/check-env.cjs",
    "export:native": "expo export --platform android --platform ios",
    "eas-build-post-install": "npm run check:env && npm run typecheck"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
